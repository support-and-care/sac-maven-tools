#!/usr/bin/env bash

set -eu -o pipefail

: "${GITHUB_ORGANIZATION:=unknown}"
: "${BRANCH:=$(git branch --show-current)}"
: "${MAVEN_PROJECTS_DIR:=maven}"

# Change to maven projects directory (create if it doesn't exist)
mkdir -p "${MAVEN_PROJECTS_DIR}"
cd "${MAVEN_PROJECTS_DIR}"

# Use latest repo if available
PATH=".repo/repo:${PATH}"

repo init \
  "https://github.com/${GITHUB_ORGANIZATION}/maven-sources.git" \
  --no-current-branch \
  -b "${BRANCH}"
hash -r

repo sync

# Start each project on its manifest-specified branch (REPO_RREV).
# Projects with a custom 'revision' attribute get their own branch,
# others get the manifest default.
repo forall -c 'repo start "${REPO_RREV}" .'
