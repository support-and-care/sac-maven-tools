#!/usr/bin/env bash

set -eu -o pipefail

: "${BRANCH:=$(git branch --show-current)}"
: "${MAVEN_PROJECTS_DIR:=maven}"

# Change to maven projects directory
cd "${MAVEN_PROJECTS_DIR}"

# THIS IS REALLY A UGLY HACK - DO NOT USE IT IN PRODUCTION - ITS JUST A SHOWCASE
declare -A branches
#branches["sisu/sisu-project"]="main"
# Specific branches like 'branches["plexus/plexus-project"]="main"'

# Use latest repo if available
PATH=".repo/repo:${PATH}"

for branch in "${!branches[@]}"; do
  origin="sac"
  case "${branch}" in
    sisu/*)
      origin="sisu"
      ;;
    plexus/*)
      origin="plexus"
      ;;
  esac
  repo forall -v "${branch}" -pc "git fetch --all --prune && ${GIT_CMD:-"git checkout -b ${branches[${branch}]} ${origin}/${branches[${branch}]}" } || true"
done